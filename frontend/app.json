{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CONATACOCH utiliza tu ubicación mientras usas el mapa conductor."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "CONATACOCH utiliza Face ID para confirmar el acceso biométrico."
        }
      ],
      "expo-secure-store"
    ]
  }
}
